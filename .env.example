# Port Configuration
PORT=5000

# Gemini API Key (Get a free key from Google AI Studio at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Express Session secret
SESSION_SECRET=some-secure-random-string-here

# GitHub App Credentials
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_INSTALLATION_ID=YOUR_GITHUB_INSTALLATION_ID

# GitHub Private Key
# Replace the newlines in your downloaded .pem private key with '\n' and enclose in quotes.
# Example: GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQ...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PEM_FILE_CONTENTS\n-----END RSA PRIVATE KEY-----"
