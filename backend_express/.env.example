# Server Configuration
PORT=5001
NODE_ENV=development
SESSION_SECRET=replace_with_a_cryptographically_secure_random_key_min_32_chars
ALLOWED_ORIGINS=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://127.0.0.1:27017/ai-review
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub OAuth App (User Login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub App (Checks & Merge Gates)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# Python Code Analyzer Microservice
PYTHON_SERVICE_URL=http://localhost:8000/analyze

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
